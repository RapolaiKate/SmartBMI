<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked: blue square with white tick -->
    <item android:state_checked="true">
        <layer-list>

            <item>
                <shape android:shape="rectangle">
                    <size
                        android:width="24dp"
                        android:height="24dp" />
                    <solid android:color="#173B70" />
                    <corners android:radius="4dp" />
                </shape>
            </item>

            <item
                android:drawable="@drawable/ic_white_check"
                android:gravity="center" />

        </layer-list>
    </item>

    <!-- Unchecked: transparent with blue outline -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="22dp"
                android:height="22dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#173B70" />
            <corners android:radius="4dp" />
        </shape>
    </item>

</selector>

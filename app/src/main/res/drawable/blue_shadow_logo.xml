<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Blue shadow -->
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="#2169F3"/>
            <corners
                android:radius="20dp"/>
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp"/>
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerColor="#802196F3"
                android:endColor="#002169F3"
                android:centerX="0.5"
                android:centerY="0.5"/>
        </shape>
    </item>

</layer-list>